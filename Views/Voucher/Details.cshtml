@model ApprovalWorkflow.Models.VoucherDetailsViewModel

@{
    ViewData["Title"] = $"Approval - Voucher {Model.Header.VoucherNo}";
    var activeUser = (ApprovalWorkflow.Models.User)ViewBag.CurrentUser;
    string authBadgeClass = Model.Header.AuthStatus switch
    {
        0 => "bg-label-warning",
        1 => "bg-label-success",
        2 => "bg-label-danger",
        _ => "bg-label-secondary"
    };
    string authBadgeIcon = Model.Header.AuthStatus switch
    {
        0 => "bx-time-five",
        1 => "bx-check-circle",
        2 => "bx-x-circle",
        _ => "bx-help-circle"
    };

    // Determine active user's approval level or role in the workflow hierarchy
    int currentUserLevel = activeUser.UserId switch
    {
        1 => 4,    // JP - Level 4 (Top Level)
        5 => 3,    // EDWIN - Level 3
        1012 => 2, // GAUTHAM - Level 2
        13 => 1,   // LISA - Level 1
        _ => activeUser.UserRole == 1 ? 4 : 0
    };

    // Calculate lower-level participants/recipients:
    var allApproversHierarchy = new List<(int UserId, string Name, int Level, string RoleDesc)>
    {
        (13, "LISA", 1, "Level 1 Approver"),
        (1012, "GAUTHAM", 2, "Level 2 Approver"),
        (5, "EDWIN", 3, "Level 3 Approver"),
        (1, "JP", 4, "Managing Director / Level 4")
    };

    var eligibleRecipients = new List<(int UserId, string DisplayName)>();

    // 1. Lower level approvers (Level < currentUserLevel)
    foreach (var app in allApproversHierarchy.Where(a => a.Level < currentUserLevel && a.UserId != activeUser.UserId))
    {
        eligibleRecipients.Add((app.UserId, $"{app.Name} ({app.RoleDesc})"));
    }

    // 2. Voucher Creator (if different from active user and not already in list)
    if (Model.Header.CreatedBy.HasValue && 
        Model.Header.CreatedBy.Value != activeUser.UserId && 
        !eligibleRecipients.Any(r => r.UserId == Model.Header.CreatedBy.Value))
    {
        string creatorName = !string.IsNullOrEmpty(Model.Header.CreatedByUsername) ? Model.Header.CreatedByUsername : $"User {Model.Header.CreatedBy.Value}";
        eligibleRecipients.Add((Model.Header.CreatedBy.Value, $"{creatorName} (Voucher Creator)"));
    }
}

<!-- Page Heading & Breadcrumb -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h4 class="fw-bold py-1 mb-1">
      <span class="text-muted fw-light">Vouchers /</span> Approval Workflow
    </h4>
    <p class="text-muted mb-0 small">
      Review and manage sequential authorization for voucher <strong>@Model.Header.VoucherNo</strong>
    </p>
  </div>
  <div class="d-flex gap-2">
    @if (Model.CanCurrentUserEdit)
    {
      <a asp-action="Edit" asp-route-id="@Model.Header.HeaderId" class="btn btn-warning btn-sm shadow-sm">
        <i class="bx bx-edit me-1"></i> Edit &amp; Resubmit
      </a>
    }
    @if (eligibleRecipients.Any())
    {
      <button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#modalSendNotification">
        <i class="bx bx-bell me-1"></i> Send Notification
      </button>
    }
    <button type="button" class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#modalAuthInfo">
      <i class="bx bx-info-circle me-1"></i> Auth Info
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
      <i class="bx bx-arrow-back me-1"></i> All Vouchers
    </a>
    <a asp-action="Create" class="btn btn-outline-primary btn-sm">
      <i class="bx bx-plus me-1"></i> New Voucher
    </a>
  </div>
</div>

@if (Model.Header.AuthStatus == 2 && Model.CanCurrentUserEdit)
{
  <div class="alert alert-danger py-3 px-4 mb-4 shadow-sm border-0 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <h6 class="alert-heading fw-bold mb-1 text-danger">
        <i class="bx bx-x-circle me-1"></i> Voucher Rejected
      </h6>
      <p class="mb-0 small text-dark">
        This voucher was rejected during approval.
        <span class="fw-semibold">As the creator, you can edit and resubmit this voucher to restart the approval workflow from Step 1.</span>
      </p>
    </div>
    <a asp-action="Edit" asp-route-id="@Model.Header.HeaderId" class="btn btn-warning btn-sm shadow-sm">
      <i class="bx bx-edit me-1"></i> Edit &amp; Resubmit Voucher
    </a>
  </div>
}

<!-- TOP VOUCHER DETAILS CARD -->
<div class="card mb-4 shadow-sm border-0">
  <div class="card-header d-flex justify-content-between align-items-center border-bottom py-3">
    <div class="d-flex align-items-center gap-3">
      <div class="avatar avatar-md bg-label-primary rounded p-2">
        <i class="bx bx-file fs-3"></i>
      </div>
      <div>
        <h5 class="card-title mb-0 text-dark fw-bold">@Model.Header.VoucherNo</h5>
        <small class="text-muted">
          Created on @Model.Header.CreatedDate.ToString("yyyy-MM-dd HH:mm") by @(Model.Header.CreatedByUsername ?? "System")
        </small>
      </div>
    </div>
    <div class="text-end">
      <span class="badge @authBadgeClass fs-6 px-3 py-2 fw-semibold">
        <i class="bx @authBadgeIcon me-1"></i> @Model.Header.AuthStatusDescription
      </span>
      <span class="badge bg-label-info ms-2 fs-6 px-3 py-2">
        Level @Model.Header.WorkflowLevel
      </span>
    </div>
  </div>

  <div class="card-body pt-4">
    <!-- Fields Grid -->
    <div class="row g-4 mb-3">
      <div class="col-sm-6 col-md-3">
        <span class="text-muted small d-block mb-1">Voucher Number</span>
        <span class="fw-semibold text-dark fs-6">@Model.Header.VoucherNo</span>
      </div>
      <div class="col-sm-6 col-md-3">
        <span class="text-muted small d-block mb-1">Voucher Date</span>
        <span class="fw-semibold text-dark fs-6">@Model.Header.Date.ToString("yyyy-MM-dd")</span>
      </div>
      <div class="col-sm-6 col-md-3">
        <span class="text-muted small d-block mb-1">Amount</span>
        <span class="fw-bold text-primary fs-5">₹@Model.Header.Amount.ToString("N2")</span>
      </div>
      <div class="col-sm-6 col-md-3">
        <span class="text-muted small d-block mb-1">Posting Date</span>
        <span class="fw-semibold fs-6 @(Model.Header.PostDate.HasValue ? "text-success" : "text-muted")">
          @(Model.Header.PostDate.HasValue ? Model.Header.PostDate.Value.ToString("yyyy-MM-dd") : "Not Posted (Pending)")
        </span>
      </div>
      <div class="col-12">
        <span class="text-muted small d-block mb-1">Narration</span>
        <p class="mb-0 bg-lighter p-2 rounded text-secondary border">
          @(string.IsNullOrWhiteSpace(Model.Header.Narration) ? "No narration provided." : Model.Header.Narration)
        </p>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Approval Workflow Details Section -->
  <div class="col-12">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header d-flex justify-content-between align-items-center border-bottom py-3">
        <div>
          <h5 class="card-title mb-0 fw-bold text-dark">
            <i class="bx bx-list-check text-primary me-2"></i>Approval Details
          </h5>
          <small class="text-muted">Four-cell workflow matrix overview &amp; active approver action</small>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-label-secondary">
            Workflow Level @Model.Header.WorkflowLevel
          </span>
          <button type="button" class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#modalAuthInfo">
            <i class="bx bx-info-circle me-1"></i> Auth Info
          </button>
        </div>
      </div>

      <div class="card-body p-4">
        <!-- 1. COMPACT FOUR-CELL APPROVAL MATRIX OVERVIEW -->
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h6 class="fw-bold text-dark mb-0 small text-uppercase" style="letter-spacing: 0.5px;">
            <i class="bx bx-grid-alt text-primary me-1"></i> Approval Matrix (All Stages)
          </h6>
          <span class="text-muted small">Sequential routing (Level 1 &rarr; Level 4)</span>
        </div>

        <div class="list-group list-group-flush border rounded-3 mb-4 shadow-xs">
          @for (int cellIndex = 1; cellIndex <= 4; cellIndex++)
          {
            var slot = Model.ApprovalSlots.FirstOrDefault(s => s.StepOrder == cellIndex);
            
            string cellUserName = cellIndex switch {
                1 => "LISA",
                2 => "GAUTHAM",
                3 => "EDWIN",
                4 => "JP",
                _ => "Unknown"
            };
            string cellRoleDesc = cellIndex switch {
                1 => "Level 1 Approver (₹50.01 - ₹100.00)",
                2 => "Level 2 Approver (₹100.01 - ₹500.00)",
                3 => "Level 3 Approver (₹500.01 - ₹1,000.00)",
                4 => "Level 4 Approver (> ₹1,000.00)",
                _ => ""
            };

            bool isRequired = slot != null;
            bool isActiveStage = slot?.IsCurrentActiveStage == true;
            bool isApproved = slot?.Status == 1;
            bool isRejected = slot?.Status == 2;
            bool isWaiting = isRequired && !isApproved && !isRejected && !isActiveStage;

            string rowBg = isActiveStage ? "bg-label-primary border-primary border-2" :
                           isApproved ? "bg-white" :
                           isRejected ? "bg-label-danger" :
                           !isRequired ? "bg-lighter opacity-75" : "bg-white";

            <div class="list-group-item px-3 py-2 @rowBg">
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <!-- Cell # and Approver & Role -->
                <div class="d-flex align-items-center gap-2" style="min-width: 260px;">
                  <span class="badge @(isActiveStage ? "bg-primary" : isApproved ? "bg-success" : isRejected ? "bg-danger" : isRequired ? "bg-secondary" : "bg-label-secondary") rounded-pill px-2 py-1">
                    Cell @cellIndex
                  </span>
                  <div>
                    <div class="d-flex align-items-center gap-2">
                      <strong class="text-dark small">@cellUserName</strong>
                      <span class="badge bg-label-info py-0 px-2" style="font-size: 0.72rem;">Level @cellIndex</span>
                    </div>
                    <div class="text-muted" style="font-size: 0.75rem;">@cellRoleDesc</div>
                  </div>
                </div>

                <!-- User Comments / Notes -->
                <div class="flex-grow-1 px-2 text-truncate" style="min-width: 200px; max-width: 480px;">
                  @if (isRequired && !string.IsNullOrWhiteSpace(slot!.UserComments))
                  {
                    <span class="small text-secondary" title="@slot.UserComments">
                      <i class="bx bx-message-rounded-dots text-primary me-1"></i>
                      <strong>Comment:</strong> "@slot.UserComments"
                    </span>
                  }
                  else if (isRequired && slot!.ActionDate.HasValue)
                  {
                    <span class="small text-muted" style="font-size: 0.75rem;">
                      <i class="bx bx-check text-success me-1"></i>Actioned by <strong>@slot.ActionedByUsername</strong> on @slot.ActionDate.Value.ToString("yyyy-MM-dd HH:mm")
                    </span>
                  }
                  else if (isActiveStage)
                  {
                    <span class="small text-primary fw-medium" style="font-size: 0.75rem;">
                      <i class="bx bx-hourglass bx-spin text-warning me-1"></i>Current pending approval stage
                    </span>
                  }
                  else if (!isRequired)
                  {
                    <span class="small text-muted fst-italic" style="font-size: 0.75rem;">
                      Not required for amount ₹@Model.Header.Amount.ToString("N2")
                    </span>
                  }
                  else
                  {
                    <span class="small text-muted fst-italic" style="font-size: 0.75rem;">
                      Waiting for prior level approval
                    </span>
                  }
                </div>

                <!-- Status Badge -->
                <div>
                  @if (!isRequired)
                  {
                    <span class="badge bg-label-notrequired py-1 px-2">
                      <i class="bx bx-minus-circle me-1"></i> Not Required
                    </span>
                  }
                  else if (isApproved)
                  {
                    <span class="badge bg-label-success py-1 px-2">
                      <i class="bx bx-check-circle me-1"></i> Approved
                    </span>
                  }
                  else if (isRejected)
                  {
                    <span class="badge bg-label-danger py-1 px-2">
                      <i class="bx bx-x-circle me-1"></i> Rejected
                    </span>
                  }
                  else if (isActiveStage)
                  {
                    <span class="badge bg-label-warning py-1 px-2">
                      <i class="bx bx-hourglass bx-spin me-1"></i> Current Pending Stage
                    </span>
                  }
                  else
                  {
                    <span class="badge bg-label-secondary py-1 px-2">
                      <i class="bx bx-lock-alt me-1"></i> Waiting
                    </span>
                  }
                </div>
              </div>
            </div>
          }
        </div>

        <!-- 2. CURRENT APPROVER ACTION CELL (LARGE) -->
        @{
          var activeSlot = Model.ApprovalSlots.FirstOrDefault(s => s.IsCurrentActiveStage);
        }

        @if (activeSlot != null && Model.Header.AuthStatus == 0)
        {
          string activeRoleDesc = activeSlot.StepOrder switch {
              1 => "Level 1 Approver (₹50.01 - ₹100.00)",
              2 => "Level 2 Approver (₹100.01 - ₹500.00)",
              3 => "Level 3 Approver (₹500.01 - ₹1,000.00)",
              4 => "Level 4 Approver (> ₹1,000.00)",
              _ => ""
          };
          bool isAuthorizedApprover = activeUser.UserId == activeSlot.AssignedUserId;

          <div class="card card-stage-active shadow-sm border-0">
            <div class="card-header bg-label-primary py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary fs-6 px-3 py-1 rounded-pill">Cell @activeSlot.StepOrder</span>
                <h6 class="mb-0 fw-bold text-dark">
                  Current Approver: @activeSlot.AssignedUsername
                </h6>
                <span class="badge bg-label-secondary ms-1">Level @activeSlot.StepOrder Approver</span>
              </div>
              <span class="badge bg-label-warning fs-6 px-3 py-1">
                <i class="bx bx-hourglass bx-spin me-1"></i> Action Required
              </span>
            </div>

            <div class="card-body p-4">
              <!-- Grid details -->
              <div class="row g-3 small mb-3">
                <div class="col-sm-4">
                  <span class="text-muted d-block mb-1">Alert Type:</span>
                  <span class="badge bg-label-info">@activeSlot.AlertTypeDescription</span>
                </div>
                <div class="col-sm-4">
                  <span class="text-muted d-block mb-1">Approval Level:</span>
                  <span class="fw-semibold text-dark">Level @activeSlot.StepOrder</span>
                </div>
                <div class="col-sm-4">
                  <span class="text-muted d-block mb-1">Role Mapping:</span>
                  <span class="text-secondary">@activeRoleDesc</span>
                </div>
                <div class="col-12 mt-2">
                  <span class="text-muted d-block mb-1">Alert Message:</span>
                  <div class="bg-lighter p-2 rounded border text-dark fw-medium">
                    <i class="bx bx-bell text-warning me-1"></i>
                    @(activeSlot.Alerts ?? $"Notification: Voucher {Model.Header.VoucherNo} requires Level {activeSlot.StepOrder} approval.")
                  </div>
                </div>
              </div>

              <!-- Action Area -->
              @if (isAuthorizedApprover)
              {
                <div class="pt-3 border-top">
                  <div class="alert alert-primary py-2 px-3 small d-flex align-items-center mb-3">
                    <i class="bx bx-shield-check fs-4 me-2"></i>
                    <div>
                      <strong>Authorized Approver:</strong> You are currently logged in as <strong>@activeUser.Username</strong>.
                    </div>
                  </div>

                  <form method="post" id="cellActionForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="HeaderId" value="@Model.Header.HeaderId" />

                    <div class="mb-3">
                      <label class="form-label small fw-semibold">Remarks / Decision Comments:</label>
                      <input type="text" name="Comments" id="cellCommentsInput" class="form-control" placeholder="Enter decision remarks (required for rejection)" maxlength="250" />
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                      <button type="submit" asp-controller="Approval" asp-action="Approve" class="btn btn-success px-4 shadow-sm fw-semibold">
                        <i class="bx bx-check-circle me-1"></i> Approve Stage @activeSlot.StepOrder
                      </button>
                      <button type="button" class="btn btn-danger px-4 shadow-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#modalReject">
                        <i class="bx bx-x-circle me-1"></i> Reject Voucher
                      </button>
                      <button type="button" class="btn btn-info px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAuthInfo">
                        <i class="bx bx-info-circle me-1"></i> Auth Info
                      </button>
                    </div>
                  </form>
                </div>
              }
              else
              {
                <div class="pt-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                  <div class="small text-muted">
                    <i class="bx bx-lock-alt text-warning me-1"></i>
                    Awaiting action from <strong>@activeSlot.AssignedUsername</strong>.
                  </div>
                  <button type="button" class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#modalAuthInfo">
                    <i class="bx bx-info-circle me-1"></i> Auth Info
                  </button>
                </div>
              }
            </div>
          </div>
        }
        else if (Model.Header.AuthStatus == 1)
        {
          <div class="alert alert-success border-0 shadow-sm d-flex justify-content-between align-items-center p-3 mb-0">
            <div class="d-flex align-items-center">
              <i class="bx bx-check-double fs-3 me-2 text-success"></i>
              <div>
                <strong class="text-success">Workflow Completed</strong>
                <div class="text-muted small">This voucher has been fully approved through all required stages and posted to accounts.</div>
              </div>
            </div>
            <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalAuthInfo">
              <i class="bx bx-info-circle me-1"></i> View Full Audit Trail
            </button>
          </div>
        }
        else if (Model.Header.AuthStatus == 2)
        {
          <div class="alert alert-danger border-0 shadow-sm d-flex justify-content-between align-items-center p-3 mb-0">
            <div class="d-flex align-items-center">
              <i class="bx bx-x-circle fs-3 me-2 text-danger"></i>
              <div>
                <strong class="text-danger">Workflow Terminated (Rejected)</strong>
                <div class="text-muted small">This voucher was rejected during approval. See comments in the matrix above or full history in Auth Info.</div>
              </div>
            </div>
            <div class="d-flex gap-2">
              @if (Model.CanCurrentUserEdit)
              {
                <a asp-action="Edit" asp-route-id="@Model.Header.HeaderId" class="btn btn-warning btn-sm shadow-sm">
                  <i class="bx bx-edit me-1"></i> Edit &amp; Resubmit
                </a>
              }
              <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#modalAuthInfo">
                <i class="bx bx-info-circle me-1"></i> View Full Audit Trail
              </button>
            </div>
          </div>
        }
      </div>
    </div>
  </div>
</div>

<!-- MODAL: APPROVE CONFIRMATION -->
<div class="modal fade" id="modalApprove" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <form asp-controller="Approval" asp-action="Approve" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="HeaderId" value="@Model.Header.HeaderId" />

        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold text-success">
            <i class="bx bx-check-circle me-1"></i> Approve Voucher
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <p>
            Are you sure you want to approve voucher <strong>@Model.Header.VoucherNo</strong> for amount <strong>₹@Model.Header.Amount.ToString("N2")</strong>?
          </p>
          <div class="mb-3">
            <label class="form-label">Approval Comments (Optional):</label>
            <input type="text" name="Comments" class="form-control" placeholder="Enter approval remarks" maxlength="100" />
          </div>
        </div>

        <div class="modal-footer border-top">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">
            <i class="bx bx-check me-1"></i> Confirm Approval
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- MODAL: REJECT CONFIRMATION -->
<div class="modal fade" id="modalReject" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <form asp-controller="Approval" asp-action="Reject" method="post" id="rejectModalForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="HeaderId" value="@Model.Header.HeaderId" />

        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold text-danger">
            <i class="bx bx-x-circle me-1"></i> Reject Voucher
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <div class="alert alert-danger py-2 small mb-3">
            <i class="bx bx-error-circle me-1"></i>
            <strong>Warning:</strong> Rejecting a voucher permanently terminates the approval workflow. It cannot be approved later.
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Mandatory Rejection Reason / Comments:</label>
            <textarea name="Comments" id="rejectReason" class="form-control" rows="3" placeholder="Provide mandatory explanation for rejection" required maxlength="100"></textarea>
          </div>
        </div>

        <div class="modal-footer border-top">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">
            <i class="bx bx-x me-1"></i> Confirm Rejection
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- MODAL: AUTH INFO (Detailed SQL Server Audit Trail) -->
<div class="modal fade" id="modalAuthInfo" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
    <div class="modal-content">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold text-primary">
          <i class="bx bx-info-circle me-1"></i> Authorization Info &amp; Audit Trail
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <h6 class="fw-bold mb-2">Voucher Workflow Overview</h6>
        <div class="row g-2 mb-4 bg-lighter p-3 rounded border">
          <div class="col-sm-3">
            <span class="text-muted small d-block">Voucher No:</span>
            <strong>@Model.Header.VoucherNo</strong>
          </div>
          <div class="col-sm-3">
            <span class="text-muted small d-block">Amount:</span>
            <strong class="text-primary">₹@Model.Header.Amount.ToString("N2")</strong>
          </div>
          <div class="col-sm-3">
            <span class="text-muted small d-block">Status:</span>
            <span class="badge @authBadgeClass">@Model.Header.AuthStatusDescription</span>
          </div>
          <div class="col-sm-3">
            <span class="text-muted small d-block">Approval Cycle:</span>
            <span class="badge bg-label-primary">Cycle @Model.CurrentCycle</span>
          </div>
        </div>

        <h6 class="fw-bold mb-2">Workflow Stages &amp; Approval Cycles</h6>
        @{
          var cycleGroups = Model.AllCycleSlots.Any() 
              ? Model.AllCycleSlots.GroupBy(s => s.Cycle).OrderByDescending(g => g.Key) 
              : Model.ApprovalSlots.GroupBy(s => s.Cycle).OrderByDescending(g => g.Key);
        }
        @foreach (var cGroup in cycleGroups)
        {
          bool isCurrent = cGroup.Key == Model.CurrentCycle;
          <div class="card mb-3 border shadow-none">
            <div class="card-header bg-lighter py-2 px-3 d-flex justify-content-between align-items-center">
              <span class="fw-bold text-dark small">
                <i class="bx bx-sync me-1 text-primary"></i>Cycle @cGroup.Key @(isCurrent ? "(Present / Current Cycle)" : "(Previous Revision Cycle)")
              </span>
              <span class="badge @(isCurrent ? (Model.Header.AuthStatus == 1 ? "bg-label-success" : Model.Header.AuthStatus == 2 ? "bg-label-danger" : "bg-label-warning") : "bg-label-secondary")">
                @(isCurrent ? Model.Header.AuthStatusDescription : "Completed / Rejected")
              </span>
            </div>
            <div class="table-responsive">
              <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Step</th>
                    <th>Alert Type</th>
                    <th>Level</th>
                    <th>Assigned User</th>
                    <th>Status</th>
                    <th>Actioned By</th>
                    <th>Timestamp</th>
                    <th>Comments</th>
                  </tr>
                </thead>
                <tbody>
                  @foreach (var slot in cGroup)
                  {
                    <tr>
                      <td>Step @slot.StepOrder</td>
                      <td><span class="badge bg-label-info">@slot.AlertTypeDescription</span></td>
                      <td>Level @slot.Level</td>
                      <td><strong>@slot.AssignedUsername</strong></td>
                      <td>
                        <span class="badge @(slot.Status == 1 ? "bg-label-success" : slot.Status == 2 ? "bg-label-danger" : slot.IsCurrentActiveStage ? "bg-label-warning" : "bg-label-secondary")">
                          @slot.StatusDescription
                        </span>
                      </td>
                      <td>@(slot.ActionedByUsername ?? "—")</td>
                      <td>@(slot.ActionDate.HasValue ? slot.ActionDate.Value.ToString("yyyy-MM-dd HH:mm") : "—")</td>
                      <td>@(string.IsNullOrWhiteSpace(slot.UserComments) ? "—" : slot.UserComments)</td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          </div>
        }

        <!-- Collapsible Dropdown: Full Audit Trail Across All Cycles -->
        <div class="card border mb-3 shadow-none">
          <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center" 
               style="cursor: pointer;" 
               data-bs-toggle="collapse" 
               data-bs-target="#collapseAuditTrail" 
               aria-expanded="false" 
               aria-controls="collapseAuditTrail">
            <span class="fw-bold text-dark">
              <i class="bx bx-history text-primary me-2"></i>Full Audit Trail Across All Cycles
            </span>
            <span class="badge bg-label-primary d-flex align-items-center gap-1">
              <span>View Audit Log</span>
              <i class="bx bx-chevron-down"></i>
            </span>
          </div>
          <div class="collapse" id="collapseAuditTrail">
            <div class="card-body p-0">
              @if (!Model.History.Any())
              {
                <p class="text-muted small p-3 mb-0">No audit events recorded yet.</p>
              }
              else
              {
                <div class="table-responsive">
                  <table class="table table-sm table-striped mb-0">
                    <thead class="table-light">
                      <tr>
                        <th>Cycle</th>
                        <th>Timestamp</th>
                        <th>Action</th>
                        <th>Actor</th>
                        <th>Stage</th>
                        <th>Comments</th>
                      </tr>
                    </thead>
                    <tbody>
                      @foreach (var h in Model.History.OrderByDescending(h => h.ActionDate).ThenByDescending(h => h.HistoryId))
                      {
                        <tr>
                          <td><span class="badge bg-label-info">Cycle @h.Cycle</span></td>
                          <td>@h.ActionDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                          <td><span class="badge bg-label-primary">@h.Action</span></td>
                          <td><strong>@h.ActionUsername</strong></td>
                          <td>Step @h.StepOrder (L@h.Level)</td>
                          <td>@(string.IsNullOrWhiteSpace(h.Comments) ? "—" : h.Comments)</td>
                        </tr>
                      }
                    </tbody>
                  </table>
                </div>
              }
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer border-top">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- MODAL: SEND NOTIFICATION TO LOWER-LEVEL PARTICIPANTS -->
<div class="modal fade" id="modalSendNotification" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <form asp-controller="Voucher" asp-action="SendNotification" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="HeaderId" value="@Model.Header.HeaderId" />

        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold text-dark">
            <i class="bx bx-bell text-warning me-1"></i> Send Notification / Comment
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <p class="small text-muted mb-3">
            Send an informational notification with remarks regarding Voucher <strong>@Model.Header.VoucherNo</strong> to lower-level approvers or the voucher creator.
          </p>

          <div class="mb-3">
            <label class="form-label fw-semibold">Select Recipient:</label>
            <select name="TargetUserId" class="form-select" required>
              <option value="">-- Choose recipient --</option>
              @foreach (var rec in eligibleRecipients)
              {
                <option value="@rec.UserId">@rec.DisplayName</option>
              }
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Comments / Remarks:</label>
            <textarea name="Comment" class="form-control" rows="3" placeholder="Enter remarks or instructions for the recipient..." required maxlength="250"></textarea>
            <small class="text-muted">This comment will appear in their Notification Inbox and the Voucher Audit Trail.</small>
          </div>
        </div>

        <div class="modal-footer border-top">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning">
            <i class="bx bx-send me-1"></i> Send Notification
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const rejectModal = document.getElementById('modalReject');
      if (rejectModal) {
        rejectModal.addEventListener('show.bs.modal', function () {
          const cellVal = document.getElementById('cellCommentsInput')?.value;
          const rejectVal = document.getElementById('rejectReason');
          if (cellVal && rejectVal && !rejectVal.value) {
            rejectVal.value = cellVal;
          }
        });
      }
    });
  </script>
}
