@model List<ApprovalWorkflow.Models.NotificationItem>

@{
    ViewData["Title"] = "My Notifications";
    var activeUser = (ApprovalWorkflow.Models.User)ViewBag.CurrentUser;
}

<!-- Page Heading & Breadcrumb -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h4 class="fw-bold py-1 mb-1">
      <span class="text-muted fw-light">Workflow /</span> Notifications
    </h4>
    <p class="text-muted mb-0 small">
      Informational notifications received by <strong>@activeUser.Username</strong>.
      <strong class="text-danger">Important: Notifications do not confer approval authority.</strong>
    </p>
  </div>
  <div>
    <span class="badge bg-label-warning fs-6 px-3 py-2">
      <i class="bx bx-bell me-1"></i> @Model.Count Notifications
    </span>
  </div>
</div>

<!-- Notifications Card -->
<div class="card shadow-sm border-0">
  <div class="card-header border-bottom py-3 d-flex justify-content-between align-items-center">
    <h5 class="card-title mb-0 fw-bold text-dark">
      <i class="bx bx-bell text-warning me-2"></i>Notification Inbox
    </h5>
  </div>

  <div class="table-responsive text-nowrap">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Voucher No</th>
          <th>Date</th>
          <th class="text-end">Amount (₹)</th>
          <th class="text-center">Workflow Level</th>
          <th class="text-center">Voucher Status</th>
          <th>Notification Alert</th>
          <th class="text-center">Action</th>
        </tr>
      </thead>
      <tbody class="table-border-bottom-0">
        @if (!Model.Any())
        {
          <tr>
            <td colspan="7" class="text-center py-5 text-muted">
              <i class="bx bx-bell-off fs-1 text-secondary opacity-50 d-block mb-2"></i>
              No notification records found for <strong>@activeUser.Username</strong>.
              <div class="small mt-1 text-secondary">
                Per the specification, notifications are received across all workflow levels (0 to 4).
              </div>
            </td>
          </tr>
        }
        else
        {
          @foreach (var item in Model)
          {
            string statusBadgeClass = item.AuthStatus switch
            {
                0 => "bg-label-warning",
                1 => "bg-label-success",
                2 => "bg-label-danger",
                _ => "bg-label-secondary"
            };

            <tr>
              <td>
                <a asp-controller="Voucher" asp-action="Details" asp-route-id="@item.HeaderId" class="fw-bold text-primary">
                  <i class="bx bx-file me-1"></i>@item.VoucherNo
                </a>
              </td>
              <td>@item.Date.ToString("yyyy-MM-dd")</td>
              <td class="text-end fw-bold text-dark">₹@item.Amount.ToString("N2")</td>
              <td class="text-center">
                <span class="badge bg-label-info">Level @item.Level</span>
              </td>
              <td class="text-center">
                <span class="badge @statusBadgeClass">@item.HeaderStatusDescription</span>
              </td>
              <td>
                <div class="small text-dark fw-medium">@(item.Alerts ?? "Voucher Notification")</div>
                @if (!string.IsNullOrWhiteSpace(item.UserComments))
                {
                  <div class="small text-muted fst-italic">@item.UserComments</div>
                }
              </td>
              <td class="text-center">
                <a asp-controller="Voucher" asp-action="Details" asp-route-id="@item.HeaderId" class="btn btn-outline-primary btn-sm px-2 py-1">
                  <i class="bx bx-show me-1"></i> View Voucher
                </a>
              </td>
            </tr>
          }
        }
      </tbody>
    </table>
  </div>
</div>
