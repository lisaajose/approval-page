@model ApprovalWorkflow.Models.NotificationsPageViewModel

@{
    ViewData["Title"] = "My Notifications";
    var activeUser = (ApprovalWorkflow.Models.User)ViewBag.CurrentUser;
}

<!-- Page Heading & Breadcrumb -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div>
    <h5 class="fw-bold py-0 mb-1">
      <span class="text-muted fw-light">Workflow /</span> Notifications
    </h5>
    <small class="text-muted">
      Notifications and stage updates for <strong>@activeUser.Username</strong>.
    </small>
  </div>
  <div class="d-flex gap-2">
    <span class="badge bg-label-primary px-2 py-1 small">
      <i class="bx bx-bell me-1"></i> Total: @Model.TotalCount
    </span>
    <span class="badge bg-label-warning px-2 py-1 small">
      <i class="bx bx-envelope me-1"></i> Unread: @Model.UnreadCount
    </span>
    <span class="badge bg-label-success px-2 py-1 small">
      <i class="bx bx-envelope-open me-1"></i> Read: @Model.ReadCount
    </span>
  </div>
</div>

<!-- FILTER TABS & BULK ACTIONS CARD -->
<div class="card shadow-sm border-0 mb-4">
  <div class="card-header border-bottom py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <!-- Filter Navigation Tabs -->
    <ul class="nav nav-pills card-header-pills small">
      <li class="nav-item">
        <a class="nav-link py-1 px-3 @(Model.CurrentFilter == "ALL" ? "active" : "")" 
           asp-controller="Approval" asp-action="Notifications" asp-route-filter="ALL">
          <i class="bx bx-list-ul me-1"></i> All
          <span class="badge rounded-pill bg-white text-dark ms-1">@Model.TotalCount</span>
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link py-1 px-3 @(Model.CurrentFilter == "UNREAD" ? "active" : "")" 
           asp-controller="Approval" asp-action="Notifications" asp-route-filter="UNREAD">
          <i class="bx bx-envelope me-1"></i> Unread
          <span class="badge rounded-pill @(Model.CurrentFilter == "UNREAD" ? "bg-white text-primary" : "bg-warning text-white") ms-1">@Model.UnreadCount</span>
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link py-1 px-3 @(Model.CurrentFilter == "READ" ? "active" : "")" 
           asp-controller="Approval" asp-action="Notifications" asp-route-filter="READ">
          <i class="bx bx-envelope-open me-1"></i> Read
          <span class="badge rounded-pill @(Model.CurrentFilter == "READ" ? "bg-white text-primary" : "bg-success text-white") ms-1">@Model.ReadCount</span>
        </a>
      </li>
    </ul>

    <!-- Quick "Mark All as Read" -->
    @if (Model.UnreadCount > 0)
    {
      <form asp-controller="Approval" asp-action="MarkNotifications" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ActionType" value="READ_ALL" />
        <input type="hidden" name="CurrentFilter" value="@Model.CurrentFilter" />
        <button type="submit" class="btn btn-outline-primary btn-sm py-1 px-2">
          <i class="bx bx-check-double me-1"></i> Mark All as Read
        </button>
      </form>
    }
  </div>

  <!-- Form for Bulk Selection & Actions -->
  <form id="bulkNotifForm" asp-controller="Approval" asp-action="MarkNotifications" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="CurrentFilter" value="@Model.CurrentFilter" />
    <input type="hidden" id="bulkActionType" name="ActionType" value="READ" />

    <!-- Action Toolbar (shows selection actions) -->
    <div class="card-body bg-lighter py-1 px-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div class="d-flex align-items-center gap-2">
        <div class="form-check me-2">
          <input class="form-check-input" type="checkbox" id="selectAllCheckbox" title="Select all visible notifications" />
          <label class="form-check-label small fw-semibold text-muted" for="selectAllCheckbox">
            Select All
          </label>
        </div>
        <span class="small text-muted" id="selectedCountText" style="font-size: 0.78rem;">0 selected</span>
      </div>

      <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-sm btn-outline-success py-0 px-2" id="btnMarkRead" onclick="submitBulkAction('READ')" disabled style="font-size: 0.78rem;">
          <i class="bx bx-envelope-open me-1"></i> Mark Selected as Read
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" id="btnMarkUnread" onclick="submitBulkAction('UNREAD')" disabled style="font-size: 0.78rem;">
          <i class="bx bx-envelope me-1"></i> Mark Selected as Unread
        </button>
      </div>
    </div>

    <!-- Compact Table of Notifications -->
    <div class="table-responsive text-nowrap">
      <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 35px;" class="text-center">#</th>
            <th style="width: 75px;" class="text-center">Status</th>
            <th style="width: 80px;" class="text-center">Action</th>
            <th style="width: 140px;">Voucher No</th>
            <th style="width: 95px;">Date</th>
            <th style="width: 110px;" class="text-end">Amount (₹)</th>
            <th style="width: 75px;" class="text-center">Level</th>
            <th style="width: 110px;" class="text-center">Voucher Status</th>
            <th>Notification Details</th>
          </tr>
        </thead>
        <tbody class="table-border-bottom-0">
          @if (!Model.Notifications.Any())
          {
            <tr>
              <td colspan="9" class="text-center py-4 text-muted">
                <i class="bx bx-bell-off fs-2 text-secondary opacity-50 d-block mb-1"></i>
                No notifications found in the <strong>@Model.CurrentFilter</strong> view.
              </td>
            </tr>
          }
          else
          {
            @foreach (var item in Model.Notifications)
            {
              string statusBadgeClass = item.AuthStatus switch
              {
                  0 => "bg-label-warning",
                  1 => "bg-label-success",
                  2 => "bg-label-danger",
                  _ => "bg-label-secondary"
              };

              string rowClass = item.IsRead ? "" : "table-active fw-medium";

              <tr class="@rowClass">
                <td class="text-center py-2">
                  <input type="checkbox" name="AuthIds" value="@item.AuthId" class="form-check-input notif-checkbox" onchange="updateSelectionState()" />
                </td>
                <td class="text-center py-2">
                  @if (item.IsRead)
                  {
                    <span class="badge bg-label-secondary py-0 px-2" style="font-size: 0.72rem;" title="Read notification">
                      <i class="bx bx-envelope-open me-1"></i>Read
                    </span>
                  }
                  else
                  {
                    <span class="badge bg-warning text-white py-0 px-2" style="font-size: 0.72rem;" title="Unread notification">
                      <i class="bx bx-envelope me-1"></i>Unread
                    </span>
                  }
                </td>
                <!-- View Voucher action button located just between status and voucher number -->
                <td class="text-center py-2">
                  <a asp-controller="Approval" asp-action="OpenNotification" asp-route-authId="@item.AuthId" asp-route-headerId="@item.HeaderId" class="btn btn-outline-primary btn-sm py-0 px-2 fw-semibold" title="View Voucher (marks as read)" style="font-size: 0.75rem;">
                    <i class="bx bx-show me-1"></i>View
                  </a>
                </td>
                <td class="py-2">
                  <a asp-controller="Approval" asp-action="OpenNotification" asp-route-authId="@item.AuthId" asp-route-headerId="@item.HeaderId" class="fw-bold text-primary small" title="Open Voucher (marks as read)">
                    <i class="bx bx-file me-1"></i>@item.VoucherNo
                  </a>
                </td>
                <td class="py-2 small text-secondary">@item.Date.ToString("yyyy-MM-dd")</td>
                <td class="text-end fw-bold text-dark py-2 small">₹@item.Amount.ToString("N2")</td>
                <td class="text-center py-2">
                  <span class="badge bg-label-info py-0 px-2" style="font-size: 0.72rem;">Level @item.Level</span>
                </td>
                <td class="text-center py-2">
                  <span class="badge @statusBadgeClass py-0 px-2" style="font-size: 0.72rem;">@item.HeaderStatusDescription</span>
                </td>
                <td class="py-2" style="white-space: normal; min-width: 250px;">
                  <div class="small text-dark @(item.IsRead ? "fw-normal text-secondary" : "fw-bold")">
                    @(item.Alerts ?? "Voucher Notification")
                  </div>
                  @if (!string.IsNullOrWhiteSpace(item.UserComments))
                  {
                    <div class="small text-muted fst-italic" style="font-size: 0.75rem;">
                      <i class="bx bx-comment-detail text-primary me-1"></i>"@item.UserComments"
                    </div>
                  }
                  @if (item.ActionDate.HasValue)
                  {
                    <div class="text-muted" style="font-size: 0.7rem;">
                      <i class="bx bx-time me-1"></i>@item.ActionDate.Value.ToString("yyyy-MM-dd HH:mm")
                      @if (!string.IsNullOrEmpty(item.ActionedByUsername))
                      {
                        <span>by <strong>@item.ActionedByUsername</strong></span>
                      }
                    </div>
                  }
                </td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>
  </form>
</div>

@section Scripts {
<script>
  function updateSelectionState() {
    const checkboxes = document.querySelectorAll('.notif-checkbox');
    const checked = document.querySelectorAll('.notif-checkbox:checked');
    const selectAll = document.getElementById('selectAllCheckbox');
    const btnRead = document.getElementById('btnMarkRead');
    const btnUnread = document.getElementById('btnMarkUnread');
    const countText = document.getElementById('selectedCountText');

    if (countText) {
      countText.innerText = checked.length + ' selected';
    }

    if (btnRead) btnRead.disabled = checked.length === 0;
    if (btnUnread) btnUnread.disabled = checked.length === 0;

    if (selectAll) {
      if (checkboxes.length > 0 && checked.length === checkboxes.length) {
        selectAll.checked = true;
        selectAll.indeterminate = false;
      } else if (checked.length > 0) {
        selectAll.checked = false;
        selectAll.indeterminate = true;
      } else {
        selectAll.checked = false;
        selectAll.indeterminate = false;
      }
    }
  }

  document.getElementById('selectAllCheckbox')?.addEventListener('change', function () {
    const isChecked = this.checked;
    document.querySelectorAll('.notif-checkbox').forEach(cb => cb.checked = isChecked);
    updateSelectionState();
  });

  function submitBulkAction(action) {
    const checked = document.querySelectorAll('.notif-checkbox:checked');
    if (checked.length === 0) {
      alert('Please select at least one notification.');
      return;
    }
    document.getElementById('bulkActionType').value = action;
    document.getElementById('bulkNotifForm').submit();
  }

  // Initialize on load
  document.addEventListener('DOMContentLoaded', updateSelectionState);
</script>
}
