@model ApprovalWorkflow.Models.EditVoucherViewModel

@{
    ViewData["Title"] = $"Edit Rejected Voucher - {Model.VoucherNo}";
    var currentUser = (ApprovalWorkflow.Models.User)ViewBag.CurrentUser;
}

<!-- Page Heading & Breadcrumbs -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h4 class="fw-bold py-1 mb-1">
      <span class="text-muted fw-light">Vouchers /</span> Edit &amp; Resubmit Voucher
    </h4>
    <p class="text-muted mb-0 small">
      Modify rejected voucher <strong>@Model.VoucherNo</strong> to initiate a fresh approval cycle starting from Step 1.
    </p>
  </div>
  <div>
    <a asp-action="Details" asp-route-id="@Model.HeaderId" class="btn btn-outline-secondary btn-sm">
      <i class="bx bx-arrow-back me-1"></i> Back to Voucher Details
    </a>
  </div>
</div>

<!-- Rejection Context Alert -->
<div class="alert alert-danger py-3 px-4 mb-4 shadow-sm border-0 d-flex align-items-start gap-3">
  <div class="avatar avatar-sm bg-danger text-white rounded p-1 flex-shrink-0">
    <i class="bx bx-x-circle fs-3"></i>
  </div>
  <div>
    <h6 class="alert-heading fw-bold mb-1">Voucher Status: Rejected</h6>
    <p class="mb-1 small">
      <strong>Rejection Feedback:</strong> 
      @(string.IsNullOrWhiteSpace(Model.LastRejectionReason) ? "No specific comments were entered during rejection." : Model.LastRejectionReason)
    </p>
    <div class="small text-muted mt-2">
      <i class="bx bx-info-circle me-1"></i>
      When you resubmit, the approval workflow will restart from <strong>Step 1</strong> for the designated approvers according to the updated amount.
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Left Column: Edit Form -->
  <div class="col-lg-7">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header border-bottom py-3">
        <h5 class="card-title mb-0 fw-bold text-dark">
          <i class="bx bx-edit text-warning me-2"></i>Update Voucher Details
        </h5>
      </div>
      <div class="card-body p-4">
        <form asp-action="Edit" method="post" id="editVoucherForm">
          @Html.AntiForgeryToken()
          <input type="hidden" asp-for="HeaderId" />

          <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small" role="alert"></div>

          <!-- Voucher Number (Readonly) -->
          <div class="mb-3">
            <label asp-for="VoucherNo" class="form-label fw-semibold">Voucher Number</label>
            <div class="input-group input-group-merge">
              <span class="input-group-text"><i class="bx bx-hash"></i></span>
              <input asp-for="VoucherNo" class="form-control bg-light" readonly />
            </div>
            <span class="text-muted small">Voucher number is preserved across all revision cycles.</span>
          </div>

          <!-- Date & Amount -->
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label asp-for="Date" class="form-label fw-semibold">Voucher Date <span class="text-danger">*</span></label>
              <div class="input-group input-group-merge">
                <span class="input-group-text"><i class="bx bx-calendar"></i></span>
                <input asp-for="Date" type="date" class="form-control" required />
              </div>
              <span asp-validation-for="Date" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
              <label asp-for="Amount" class="form-label fw-semibold">Amount (₹) <span class="text-danger">*</span></label>
              <div class="input-group input-group-merge">
                <span class="input-group-text fw-bold">₹</span>
                <input asp-for="Amount" id="txtAmount" type="number" step="0.01" min="0" class="form-control fw-bold text-primary fs-5" placeholder="0.00" required />
              </div>
              <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>
          </div>

          <!-- Narration -->
          <div class="mb-3">
            <label asp-for="Narration" class="form-label fw-semibold">Narration / Description</label>
            <textarea asp-for="Narration" rows="3" class="form-control" placeholder="Update transaction purpose or expenditure description (max 100 characters)..." maxlength="100"></textarea>
            <span asp-validation-for="Narration" class="text-danger small"></span>
          </div>

          <!-- Creator Context -->
          <div class="alert alert-light border py-2 px-3 mb-4 d-flex justify-content-between align-items-center">
            <div class="small">
              <span class="text-muted d-block">Resubmitted By (Creator):</span>
              <strong class="text-dark"><i class="bx bx-user-check me-1 text-primary"></i>@currentUser.Username</strong>
            </div>
          </div>

          <!-- Buttons -->
          <div class="d-flex justify-content-end gap-2">
            <a asp-action="Details" asp-route-id="@Model.HeaderId" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-warning px-4 shadow-sm fw-semibold">
              <i class="bx bx-send me-1"></i> Resubmit for Approval
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Right Column: Live Approval Matrix Level Preview -->
  <div class="col-lg-5">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header border-bottom py-3">
        <h5 class="card-title mb-0 fw-bold text-dark">
          <i class="bx bx-check-shield text-info me-2"></i>New Cycle Approval Preview
        </h5>
        <small class="text-muted">Calculated dynamically from the new amount</small>
      </div>
      <div class="card-body p-4">
        <!-- Live Workflow Tier Indicator -->
        <div class="p-3 rounded border mb-4 bg-lighter" id="levelPreviewBox">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-muted small fw-semibold">Projected Workflow Tier:</span>
            <span class="badge bg-primary fs-6" id="badgeLevel">Level 2</span>
          </div>
          <h6 class="fw-bold text-dark mb-1" id="lblLevelTitle">Medium Expenditure</h6>
          <p class="text-muted small mb-0" id="lblLevelDesc">
            Sequential approval required from <strong>Lisa (Step 1)</strong> then <strong>Gautham (Step 2)</strong>.
          </p>
        </div>

        <h6 class="fw-semibold text-dark small mb-3">Required Approvers for New Cycle:</h6>
        <div class="d-flex flex-column gap-2" id="stepsContainer">
          <!-- Step 1 -->
          <div class="p-2 rounded border d-flex align-items-center gap-3 bg-white" id="step1Box">
            <span class="badge bg-primary rounded-circle p-2">1</span>
            <div class="flex-grow-1">
              <div class="fw-semibold text-dark small">Step 1: LISA</div>
              <div class="text-muted small">Level 1 Approver</div>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="p-2 rounded border d-flex align-items-center gap-3 bg-white" id="step2Box">
            <span class="badge bg-secondary rounded-circle p-2" id="step2Badge">2</span>
            <div class="flex-grow-1">
              <div class="fw-semibold text-dark small">Step 2: GAUTHAM</div>
              <div class="text-muted small">Level 2 Approver</div>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="p-2 rounded border d-flex align-items-center gap-3 bg-white" id="step3Box">
            <span class="badge bg-secondary rounded-circle p-2" id="step3Badge">3</span>
            <div class="flex-grow-1">
              <div class="fw-semibold text-dark small">Step 3: EDWIN</div>
              <div class="text-muted small">Level 3 Approver</div>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="p-2 rounded border d-flex align-items-center gap-3 bg-white" id="step4Box">
            <span class="badge bg-secondary rounded-circle p-2" id="step4Badge">4</span>
            <div class="flex-grow-1">
              <div class="fw-semibold text-dark small">Step 4: JP</div>
              <div class="text-muted small">Managing Director / Level 4 Approver</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
  <script>
    function updatePreview() {
      const val = parseFloat(document.getElementById('txtAmount').value) || 0;
      let level = 0;
      let title = '';
      let desc = '';

      if (val >= 0 && val <= 50.00) {
        level = 0;
        title = 'Low Value Expenditure (Auto-Approval)';
        desc = 'Vouchers ₹50.00 or below are automatically approved on save. Notification sent to JP.';
      } else if (val > 50.00 && val <= 100.00) {
        level = 1;
        title = 'Tier 1 Expenditure';
        desc = 'Requires single approval by LISA (Step 1).';
      } else if (val > 100.00 && val <= 500.00) {
        level = 2;
        title = 'Tier 2 Expenditure';
        desc = 'Sequential approval: LISA (Step 1) -> GAUTHAM (Step 2).';
      } else if (val > 500.00 && val <= 1000.00) {
        level = 3;
        title = 'Tier 3 Expenditure';
        desc = 'Sequential approval: LISA (Step 1) -> GAUTHAM (Step 2) -> EDWIN (Step 3).';
      } else {
        level = 4;
        title = 'Tier 4 High-Value Expenditure';
        desc = 'Sequential approval: LISA (Step 1) -> GAUTHAM (Step 2) -> EDWIN (Step 3) -> JP (Step 4).';
      }

      document.getElementById('badgeLevel').innerText = 'Level ' + level;
      document.getElementById('lblLevelTitle').innerText = title;
      document.getElementById('lblLevelDesc').innerText = desc;

      const setVisible = (boxId, visible) => {
        const el = document.getElementById(boxId);
        if (el) {
          el.style.opacity = visible ? '1' : '0.4';
          el.classList.toggle('bg-light', !visible);
        }
      };

      setVisible('step1Box', level >= 1);
      setVisible('step2Box', level >= 2);
      setVisible('step3Box', level >= 3);
      setVisible('step4Box', level >= 4);
    }

    document.getElementById('txtAmount').addEventListener('input', updatePreview);
    document.addEventListener('DOMContentLoaded', updatePreview);
  </script>
}
