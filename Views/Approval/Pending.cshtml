@model List<ApprovalWorkflow.Models.PendingApprovalItem>

@{
    ViewData["Title"] = "My Pending Approvals";
    var activeUser = (ApprovalWorkflow.Models.User)ViewBag.CurrentUser;
}

<!-- Page Heading & Breadcrumb -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div>
    <h5 class="fw-bold py-0 mb-1">
      <span class="text-muted fw-light">Workflow /</span> My Pending Approvals
    </h5>
    <small class="text-muted">
      Showing vouchers where <strong>@activeUser.Username</strong> is the authorized actor for the current sequential stage.
    </small>
  </div>
  <div>
    <span class="badge bg-label-primary px-2 py-1 small">
      <i class="bx bx-time-five me-1"></i> @Model.Count Pending Tasks
    </span>
  </div>
</div>

<!-- Pending Approvals Card -->
<div class="card shadow-sm border-0">
  <div class="card-header border-bottom py-2 d-flex justify-content-between align-items-center">
    <h6 class="card-title mb-0 fw-bold text-dark small text-uppercase" style="letter-spacing: 0.5px;">
      <i class="bx bx-task text-primary me-2"></i>Actionable Approval Tasks
    </h6>
  </div>

  <div class="table-responsive text-nowrap">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th style="width: 80px;" class="text-center">Action</th>
          <th style="width: 140px;">Voucher No</th>
          <th style="width: 95px;">Date</th>
          <th>Narration</th>
          <th style="width: 110px;" class="text-end">Amount (₹)</th>
          <th style="width: 80px;" class="text-center">Level</th>
          <th style="width: 115px;" class="text-center">Stage</th>
          <th>Alert Message</th>
        </tr>
      </thead>
      <tbody class="table-border-bottom-0">
        @if (!Model.Any())
        {
          <tr>
            <td colspan="8" class="text-center py-4 text-muted">
              <i class="bx bx-check-double fs-2 text-success d-block mb-1"></i>
              <strong>All caught up!</strong> No pending approval tasks assigned to <strong>@activeUser.Username</strong>.
            </td>
          </tr>
        }
        else
        {
          @foreach (var item in Model)
          {
            <tr>
              <td class="text-center py-2">
                <a asp-controller="Voucher" asp-action="Details" asp-route-id="@item.HeaderId" class="btn btn-outline-primary btn-sm py-0 px-2 fw-semibold" title="View & Act on Voucher" style="font-size: 0.75rem;">
                  <i class="bx bx-show me-1"></i>View
                </a>
              </td>
              <td class="py-2">
                <a asp-controller="Voucher" asp-action="Details" asp-route-id="@item.HeaderId" class="fw-bold text-primary small">
                  <i class="bx bx-file me-1"></i>@item.VoucherNo
                </a>
              </td>
              <td class="py-2 small text-secondary">@item.Date.ToString("yyyy-MM-dd")</td>
              <td class="py-2 small">
                <span class="text-truncate d-inline-block text-secondary" style="max-width: 220px;" title="@item.Narration">
                  @(string.IsNullOrWhiteSpace(item.Narration) ? "—" : item.Narration)
                </span>
              </td>
              <td class="text-end fw-bold text-dark py-2 small">
                ₹@item.Amount.ToString("N2")
              </td>
              <td class="text-center py-2">
                <span class="badge bg-label-info py-0 px-2" style="font-size: 0.72rem;">Level @item.WorkflowLevel</span>
              </td>
              <td class="text-center py-2">
                <span class="badge bg-primary py-0 px-2" style="font-size: 0.72rem;">
                  Stage @item.StepOrder (Lvl @item.Level)
                </span>
              </td>
              <td class="py-2 small text-secondary">
                @(item.Alerts ?? "Approval Alert")
              </td>
            </tr>
          }
        }
      </tbody>
    </table>
  </div>
</div>
