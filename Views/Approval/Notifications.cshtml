@model List<ApprovalWorkflow.Models.NotificationItem>

@{
    ViewData["Title"] = "My Notifications";
    var activeUser = (ApprovalWorkflow.Models.User)ViewBag.CurrentUser;
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-bell text-warning me-2"></i>Notifications
        </h2>
        <p class="text-muted mb-0">
            Informational alerts received by <strong>@activeUser.Username</strong> (UserId: @activeUser.UserId).
            <span class="text-danger fw-semibold">Note: Notifications do not confer approval permissions.</span>
        </p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <span class="badge bg-warning text-dark fs-6 px-3 py-2">
            @Model.Count Notifications
        </span>
    </div>
</div>

<div class="card border-0 shadow-sm bg-white">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-secondary">
            <i class="bi bi-inbox-fill me-2"></i>Notification Inbox
        </h5>
        <span class="text-muted small">Fetched via <code>dbo.usp_GetNotifications</code></span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th scope="col" class="ps-4">Voucher No</th>
                    <th scope="col">Date</th>
                    <th scope="col" class="text-end">Amount (₹)</th>
                    <th scope="col" class="text-center">Workflow Level</th>
                    <th scope="col" class="text-center">Voucher Status</th>
                    <th scope="col">Notification Message</th>
                    <th scope="col" class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-bell-slash fs-1 text-secondary opacity-50 d-block mb-2"></i>
                            No notifications for @activeUser.Username.
                            <div class="small mt-1 text-secondary">
                                Switch to <strong>JP (UserId 1)</strong> to view notifications created across all workflow levels.
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">
                                <a asp-controller="Voucher" asp-action="Details" asp-route-id="@item.HeaderId" class="text-decoration-none">
                                    @item.VoucherNo
                                </a>
                            </td>
                            <td>@item.Date.ToString("yyyy-MM-dd")</td>
                            <td class="text-end fw-bold">₹@item.Amount.ToString("N2")</td>
                            <td class="text-center">
                                <span class="badge bg-info bg-opacity-10 text-dark border border-info border-opacity-25 px-2 py-1">
                                    Level @item.Level
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.AuthStatus == 0)
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (item.AuthStatus == 1)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                            </td>
                            <td>
                                <span class="small text-dark fw-medium">@(item.Alerts ?? "Voucher Notification")</span>
                                @if (!string.IsNullOrWhiteSpace(item.UserComments))
                                {
                                    <div class="text-muted small fst-italic">@item.UserComments</div>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-controller="Voucher" asp-action="Details" asp-route-id="@item.HeaderId" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye me-1"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
