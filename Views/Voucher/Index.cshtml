@model List<ApprovalWorkflow.Models.Voucher>

@{
    ViewData["Title"] = "All Vouchers";
    var currentUser = (ApprovalWorkflow.Models.User?)ViewBag.CurrentUser;
    var pendingCount = Model.Count(v => v.AuthStatus == 0);
    var approvedCount = Model.Count(v => v.AuthStatus == 1);
    var rejectedCount = Model.Count(v => v.AuthStatus == 2);
}

<!-- Page Heading & Breadcrumb -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h4 class="fw-bold py-1 mb-1">
      <span class="text-muted fw-light">Dashboard /</span> Transaction Vouchers
    </h4>
    <p class="text-muted mb-0 small">
      Real-time overview of financial vouchers managed under the SQL Server stored procedure workflow.
    </p>
  </div>
  <div>
    <a asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
      <i class="bx bx-plus me-1"></i> New Voucher
    </a>
  </div>
</div>

<!-- Metrics Cards -->
<div class="row g-4 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex align-items-start justify-content-between">
          <div class="content-left">
            <span class="text-muted small fw-semibold">Total Vouchers</span>
            <div class="d-flex align-items-center my-1">
              <h3 class="mb-0 me-2 fw-bold text-dark">@Model.Count</h3>
            </div>
            <small class="text-muted">Registered in database</small>
          </div>
          <div class="avatar">
            <span class="avatar-initial rounded bg-label-primary p-2">
              <i class="bx bx-receipt fs-4"></i>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex align-items-start justify-content-between">
          <div class="content-left">
            <span class="text-muted small fw-semibold">Pending Approval</span>
            <div class="d-flex align-items-center my-1">
              <h3 class="mb-0 me-2 fw-bold text-warning">@pendingCount</h3>
            </div>
            <small class="text-muted">In active sequential stages</small>
          </div>
          <div class="avatar">
            <span class="avatar-initial rounded bg-label-warning p-2">
              <i class="bx bx-time-five fs-4"></i>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex align-items-start justify-content-between">
          <div class="content-left">
            <span class="text-muted small fw-semibold">Fully Approved</span>
            <div class="d-flex align-items-center my-1">
              <h3 class="mb-0 me-2 fw-bold text-success">@approvedCount</h3>
            </div>
            <small class="text-muted">Completed &amp; Posted</small>
          </div>
          <div class="avatar">
            <span class="avatar-initial rounded bg-label-success p-2">
              <i class="bx bx-check-circle fs-4"></i>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex align-items-start justify-content-between">
          <div class="content-left">
            <span class="text-muted small fw-semibold">Rejected</span>
            <div class="d-flex align-items-center my-1">
              <h3 class="mb-0 me-2 fw-bold text-danger">@rejectedCount</h3>
            </div>
            <small class="text-muted">Terminated workflows</small>
          </div>
          <div class="avatar">
            <span class="avatar-initial rounded bg-label-danger p-2">
              <i class="bx bx-x-circle fs-4"></i>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Vouchers Table Card -->
<div class="card shadow-sm border-0">
  <div class="card-header border-bottom py-3 d-flex justify-content-between align-items-center">
    <h5 class="card-title mb-0 fw-bold text-dark">
      <i class="bx bx-table text-primary me-2"></i>Financial Voucher Records
    </h5>
    <span class="badge bg-label-secondary">@Model.Count items</span>
  </div>

  <div class="table-responsive text-nowrap">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Voucher No</th>
          <th>Date</th>
          <th>Narration</th>
          <th class="text-end">Amount (₹)</th>
          <th class="text-center">Workflow Level</th>
          <th class="text-center">Status</th>
          <th>Posting Date</th>
          <th class="text-center">Actions</th>
        </tr>
      </thead>
      <tbody class="table-border-bottom-0">
        @if (!Model.Any())
        {
          <tr>
            <td colspan="8" class="text-center py-5 text-muted">
              <i class="bx bx-folder-open fs-1 d-block mb-2 text-secondary opacity-50"></i>
              No voucher records found. Click <strong>New Voucher</strong> to initialize your first transaction!
            </td>
          </tr>
        }
        else
        {
          @foreach (var voucher in Model)
          {
            string statusBadgeClass = voucher.AuthStatus switch
            {
                0 => "bg-label-warning",
                1 => "bg-label-success",
                2 => "bg-label-danger",
                _ => "bg-label-secondary"
            };
            string statusIcon = voucher.AuthStatus switch
            {
                0 => "bx-time-five",
                1 => "bx-check-circle",
                2 => "bx-x-circle",
                _ => "bx-help-circle"
            };

            <tr>
              <td>
                <a asp-action="Details" asp-route-id="@voucher.HeaderId" class="fw-bold text-primary">
                  <i class="bx bx-file me-1"></i>@voucher.VoucherNo
                </a>
              </td>
              <td>@voucher.Date.ToString("yyyy-MM-dd")</td>
              <td>
                <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@voucher.Narration">
                  @(string.IsNullOrWhiteSpace(voucher.Narration) ? "—" : voucher.Narration)
                </span>
              </td>
              <td class="text-end fw-bold text-dark">
                ₹@voucher.Amount.ToString("N2")
              </td>
              <td class="text-center">
                <span class="badge bg-label-info">Level @voucher.WorkflowLevel</span>
              </td>
              <td class="text-center">
                <span class="badge @statusBadgeClass">
                  <i class="bx @statusIcon me-1"></i>@voucher.AuthStatusDescription
                </span>
              </td>
              <td>
                @(voucher.PostDate.HasValue ? voucher.PostDate.Value.ToString("yyyy-MM-dd") : "—")
              </td>
              <td class="text-center">
                <div class="d-inline-flex gap-1">
                  <a asp-action="Details" asp-route-id="@voucher.HeaderId" class="btn btn-outline-primary btn-sm px-2 py-1">
                    <i class="bx bx-show me-1"></i> Approval Page
                  </a>
                  @if (voucher.AuthStatus == 2 && (voucher.CreatedBy == currentUser?.UserId || currentUser?.UserRole == 1))
                  {
                    <a asp-action="Edit" asp-route-id="@voucher.HeaderId" class="btn btn-outline-warning btn-sm px-2 py-1" title="Edit & Resubmit">
                      <i class="bx bx-edit"></i> Edit
                    </a>
                  }
                </div>
              </td>
            </tr>
          }
        }
      </tbody>
    </table>
  </div>
</div>
