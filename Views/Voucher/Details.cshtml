@model ApprovalWorkflow.Models.VoucherDetailsViewModel

@{
    ViewData["Title"] = $"Voucher Details - {Model.Header.VoucherNo}";
    var activeUser = (ApprovalWorkflow.Models.User)ViewBag.CurrentUser;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-outline-secondary me-3 btn-sm">
            <i class="bi bi-arrow-left"></i> All Vouchers
        </a>
        <div>
            <div class="d-flex align-items-center gap-2">
                <h3 class="fw-bold mb-0">@Model.Header.VoucherNo</h3>
                @if (Model.Header.AuthStatus == 0)
                {
                    <span class="badge bg-warning text-dark fs-6 px-3 py-1"><i class="bi bi-clock me-1"></i>Pending Approval</span>
                }
                else if (Model.Header.AuthStatus == 1)
                {
                    <span class="badge bg-success fs-6 px-3 py-1"><i class="bi bi-check-circle me-1"></i>Fully Approved & Posted</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6 px-3 py-1"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                }
            </div>
            <span class="text-muted small">
                Created on @Model.Header.CreatedDate.ToString("yyyy-MM-dd HH:mm") by @(Model.Header.CreatedByUsername ?? "User")
            </span>
        </div>
    </div>

    <div class="text-end">
        <span class="text-muted small d-block">Voucher Amount</span>
        <span class="fw-bold fs-3 text-primary">₹@Model.Header.Amount.ToString("N2")</span>
        <span class="badge bg-light text-dark border ms-2">Level @Model.Header.WorkflowLevel</span>
    </div>
</div>

<!-- Overview Cards -->
<div class="card mb-4 bg-white border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-3">
                <span class="text-muted small d-block">Voucher Date</span>
                <strong class="fs-6">@Model.Header.Date.ToString("yyyy-MM-dd")</strong>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Posting Date</span>
                <strong class="fs-6">@(Model.Header.PostDate.HasValue ? Model.Header.PostDate.Value.ToString("yyyy-MM-dd") : "Not Posted (Pending)")</strong>
            </div>
            <div class="col-md-6">
                <span class="text-muted small d-block">Narration / Description</span>
                <span class="fs-6 text-secondary">@(string.IsNullOrWhiteSpace(Model.Header.Narration) ? "—" : Model.Header.Narration)</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- LEFT COLUMN: The 4 Vertically Arranged Cells / Slots Panel -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm bg-white p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div>
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-view-stacked text-primary me-2"></i>Approval Details (4-Slot Panel)
                    </h5>
                    <span class="text-muted small">Arranged vertically per Guide Line specification</span>
                </div>
                <span class="badge bg-light text-dark border">
                    Workflow Level @Model.Header.WorkflowLevel
                </span>
            </div>

            <!-- Vertical Slots Container -->
            <div class="d-flex flex-column gap-3">
                @for (int slotIndex = 1; slotIndex <= 4; slotIndex++)
                {
                    var slot = Model.ApprovalSlots.FirstOrDefault(s => s.StepOrder == slotIndex);
                    string defaultSlotUser = slotIndex switch {
                        1 => "Lisa (UserId: 13)",
                        2 => "Gautham (UserId: 1012)",
                        3 => "Edwin (UserId: 5)",
                        4 => "JP (UserId: 1)",
                        _ => "N/A"
                    };

                    <div class="card border @(slot?.IsCurrentActiveStage == true ? "border-primary shadow-sm" : slot?.Status == 1 ? "border-success bg-light bg-opacity-25" : slot?.Status == 2 ? "border-danger bg-light bg-opacity-25" : "border-light-subtle bg-light bg-opacity-50")">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @(slot?.Status == 1 ? "bg-success" : slot?.Status == 2 ? "bg-danger" : slot?.IsCurrentActiveStage == true ? "bg-primary" : "bg-secondary") rounded-pill">
                                        Slot @slotIndex
                                    </span>
                                    <strong class="fs-6 text-dark">
                                        Level @slotIndex Approval
                                    </strong>
                                </div>

                                <div>
                                    @if (slot == null)
                                    {
                                        <span class="badge bg-light text-muted border">Not Applicable for Level @Model.Header.WorkflowLevel</span>
                                    }
                                    else if (slot.Status == 1)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i>Approved</span>
                                    }
                                    else if (slot.Status == 2)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Rejected / Terminated</span>
                                    }
                                    else if (slot.IsCurrentActiveStage)
                                    {
                                        <span class="badge bg-primary"><i class="bi bi-hourglass-top me-1"></i>Current Pending Stage</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-lock me-1"></i>Waiting for Prerequisite Stage</span>
                                    }
                                </div>
                            </div>

                            @if (slot != null)
                            {
                                <div class="row g-2 small mb-2">
                                    <div class="col-sm-6">
                                        <span class="text-muted">Assigned User:</span>
                                        <strong class="text-dark d-block">
                                            <i class="bi bi-person-fill text-secondary me-1"></i>@slot.AssignedUsername (ID: @slot.AssignedUserId)
                                        </strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="text-muted">Alert Type:</span>
                                        <strong class="text-dark d-block">
                                            <span class="badge bg-info bg-opacity-10 text-dark border border-info border-opacity-25">@slot.AlertTypeDescription</span>
                                        </strong>
                                    </div>
                                    <div class="col-12">
                                        <span class="text-muted">Alerts Message:</span>
                                        <span class="text-dark fw-medium d-block bg-white p-2 rounded border mt-1">
                                            <i class="bi bi-bell text-warning me-1"></i>@(slot.Alerts ?? "Approval Alert")
                                        </span>
                                    </div>
                                    <div class="col-12">
                                        <span class="text-muted">User Comments:</span>
                                        <span class="text-secondary d-block fst-italic">
                                            @(string.IsNullOrWhiteSpace(slot.UserComments) ? "No comments recorded." : slot.UserComments)
                                        </span>
                                    </div>
                                    @if (slot.ActionDate.HasValue)
                                    {
                                        <div class="col-12 text-muted text-end small">
                                            <i class="bi bi-calendar-check me-1"></i>Actioned by @slot.ActionedByUsername on @slot.ActionDate.Value.ToString("yyyy-MM-dd HH:mm:ss")
                                        </div>
                                    }
                                </div>

                                <!-- Action Form if this slot is active -->
                                @if (slot.IsCurrentActiveStage && Model.Header.AuthStatus == 0)
                                {
                                    <div class="mt-3 pt-3 border-top bg-white p-3 rounded border">
                                        @if (activeUser.UserId == slot.AssignedUserId)
                                        {
                                            <div class="alert alert-primary py-2 px-3 small d-flex align-items-center mb-3">
                                                <i class="bi bi-shield-check fs-5 me-2 text-primary"></i>
                                                <div>
                                                    <strong>Authorized:</strong> You are logged in as <strong>@activeUser.Username</strong> (Assigned Approver for this stage).
                                                </div>
                                            </div>

                                            <form method="post" id="actionForm">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="HeaderId" value="@Model.Header.HeaderId" />
                                                
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold small text-secondary">Comments on Decision:</label>
                                                    <input type="text" name="Comments" id="txtDecisionComments" class="form-control form-control-sm" placeholder="Enter reason or remarks (mandatory for rejection)" maxlength="100" />
                                                </div>

                                                <div class="d-flex gap-2">
                                                    <button type="submit" asp-controller="Approval" asp-action="Approve" class="btn btn-success btn-sm px-3 shadow-sm fw-semibold">
                                                        <i class="bi bi-check-lg me-1"></i> Approve Stage @slot.StepOrder
                                                    </button>
                                                    <button type="submit" asp-controller="Approval" asp-action="Reject" class="btn btn-danger btn-sm px-3 shadow-sm fw-semibold" onclick="return confirmRejection();">
                                                        <i class="bi bi-x-lg me-1"></i> Reject Voucher
                                                    </button>
                                                </div>
                                            </form>
                                        }
                                        else
                                        {
                                            <div class="alert alert-light border py-2 px-3 small text-muted mb-0 d-flex align-items-center justify-content-between">
                                                <div>
                                                    <i class="bi bi-lock-fill text-warning me-1"></i>
                                                    Stage awaiting action from <strong>@slot.AssignedUsername</strong>. Current active user is <strong>@activeUser.Username</strong>.
                                                </div>
                                                <form asp-controller="Approval" asp-action="SwitchUser" method="post" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userId" value="@slot.AssignedUserId" />
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                    <button type="submit" class="btn btn-outline-primary btn-sm py-0 px-2" title="Switch to @slot.AssignedUsername for testing">
                                                        Switch to @slot.AssignedUsername
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted small">
                                    Voucher amount ₹@Model.Header.Amount.ToString("N2") does not require Level @slotIndex approval.
                                    Standard assigned approver at this level: @defaultSlotUser.
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN: Notifications (JP) & Complete Audit Trail -->
    <div class="col-lg-5">
        <div class="d-flex flex-column gap-4">
            
            <!-- JP Notifications Card -->
            <div class="card border-0 shadow-sm bg-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-bell-fill text-warning me-2"></i>Notifications (JP)
                    </h5>
                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 small">
                        Alert Type 0
                    </span>
                </div>

                <p class="text-muted small mb-3">
                    Per the Guide Line sheet, JP (UserId 1) receives notification alerts for vouchers across all amount levels.
                    <strong>Notification records do not confer approval permissions.</strong>
                </p>

                @if (!Model.Notifications.Any())
                {
                    <div class="alert alert-light text-muted small border mb-0">
                        No separate notification records generated for this voucher.
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush border rounded">
                        @foreach (var notif in Model.Notifications)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <strong class="text-dark small"><i class="bi bi-person-circle me-1 text-primary"></i>JP (UserId 1)</strong>
                                    <span class="badge bg-light text-secondary border">Notification Alert</span>
                                </div>
                                <div class="text-dark small fw-medium mb-1">
                                    @notif.Alerts
                                </div>
                                @if (!string.IsNullOrWhiteSpace(notif.UserComments))
                                {
                                    <div class="text-muted small fst-italic">
                                        @notif.UserComments
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Immutable Audit Trail History Card -->
            <div class="card border-0 shadow-sm bg-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-clock-history text-secondary me-2"></i>Workflow Audit History
                    </h5>
                    <span class="badge bg-light text-dark border">t_ApprovalHistory</span>
                </div>

                @if (!Model.History.Any())
                {
                    <div class="text-muted small text-center py-3">No audit history entries recorded.</div>
                }
                else
                {
                    <div class="timeline position-relative ps-3 border-start border-2 border-primary border-opacity-25">
                        @foreach (var eventItem in Model.History)
                        {
                            <div class="mb-3 position-relative">
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <div>
                                        <span class="badge @(eventItem.Action == "APPROVED" ? "bg-success" : eventItem.Action == "REJECTED" ? "bg-danger" : eventItem.Action == "AUTO_APPROVED" ? "bg-info text-white" : "bg-primary") me-1">
                                            @eventItem.Action
                                        </span>
                                        <strong class="small text-dark">@eventItem.ActionUsername</strong>
                                    </div>
                                    <span class="text-muted small">@eventItem.ActionDate.ToString("HH:mm:ss")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(eventItem.Comments))
                                {
                                    <div class="text-secondary small mt-1 bg-light p-2 rounded">
                                        @eventItem.Comments
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmRejection() {
            const comments = document.getElementById('txtDecisionComments').value.trim();
            if (!comments) {
                alert('Please enter a rejection reason in the comments box.');
                document.getElementById('txtDecisionComments').focus();
                return false;
            }
            return confirm('Are you sure you want to REJECT this voucher? Once rejected, the voucher cannot subsequently be approved.');
        }
    </script>
}
