@inject ApprovalWorkflow.Services.IApprovalService ApprovalService
@inject ApprovalWorkflow.Services.IUserContextService UserContextService

@{
    var activeUser = await UserContextService.GetCurrentUserAsync();
    var allUsers = await ApprovalService.GetAllUsersAsync();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!doctype html>
<html
  lang="en"
  class="layout-menu-fixed layout-compact"
  data-assets-path="~/assets/"
  data-template="vertical-menu-template-free">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />

    <title>@ViewData["Title"] - Approval Workflow System</title>

    <meta name="description" content="Sneat Bootstrap 5 Approval Workflow Management System" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/assets/img/favicon/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet" />

    <link rel="stylesheet" href="~/assets/vendor/fonts/iconify-icons.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="~/assets/css/demo.css" />

    <!-- Vendors CSS -->
    <link rel="stylesheet" href="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />

    <!-- Helpers -->
    <script src="~/assets/vendor/js/helpers.js"></script>
    <script src="~/assets/js/config.js"></script>

    <style>
      .bg-label-pending { background-color: #fff8e5; color: #ffab00; }
      .bg-label-approved { background-color: #e8fadf; color: #71dd37; }
      .bg-label-rejected { background-color: #ffe0db; color: #ff3e1d; }
      .bg-label-notrequired { background-color: #f2f3f5; color: #8592a3; }
      .card-stage-active { border: 2px solid #696cff !important; box-shadow: 0 4px 14px rgba(105, 108, 255, 0.25) !important; }
      .card-stage-done { border-left: 4px solid #71dd37 !important; }
      .card-stage-rejected { border-left: 4px solid #ff3e1d !important; }
      .card-stage-waiting { border-left: 4px solid #8592a3 !important; opacity: 0.85; }
    </style>
  </head>

  <body>
    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-content-navbar">
      <div class="layout-container">
        <!-- Menu (Sidebar) -->
        <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
          <div class="app-brand demo">
            <a asp-controller="Voucher" asp-action="Index" class="app-brand-link">
              <span class="app-brand-logo demo">
                <span class="text-primary">
                  <svg width="25" viewBox="0 0 25 42" version="1.1" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <path d="M13.7918663,0.358365126 L3.39788168,7.44174259 C0.566865006,9.69408886 -0.379795268,12.4788597 0.557900856,15.7960551 C0.68998853,16.2305145 1.09562888,17.7872135 3.12357076,19.2293357 C3.8146334,19.7207684 5.32369333,20.3834223 7.65075054,21.2172976 L7.59773219,21.2525164 L2.63468769,24.5493413 C0.445452254,26.3002124 0.0884951797,28.5083815 1.56381646,31.1738486 C2.83770406,32.8170431 5.20850219,33.2640127 7.09180128,32.5391577 C8.347334,32.0559211 11.4559176,30.0011079 16.4175519,26.3747182 C18.0338572,24.4997857 18.6973423,22.4544883 18.4080071,20.2388261 C17.963753,17.5346866 16.1776345,15.5799961 13.0496516,14.3747546 L10.9194936,13.4715819 L18.6192054,7.984237 L13.7918663,0.358365126 Z" id="path-1"></path>
                    </defs>
                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                      <g transform="translate(-27.000000, -15.000000)">
                        <g transform="translate(27.000000, 15.000000)">
                          <g transform="translate(0.000000, 8.000000)">
                            <mask id="mask-2" fill="white"><use href="#path-1"></use></mask>
                            <use fill="currentColor" href="#path-1"></use>
                          </g>
                        </g>
                      </g>
                    </g>
                  </svg>
                </span>
              </span>
              <span class="app-brand-text demo menu-text fw-bold ms-2">ApprovalFlow</span>
            </a>

            <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto d-block d-xl-none">
              <i class="bx bx-chevron-left bx-sm align-middle"></i>
            </a>
          </div>

          <div class="menu-divider mt-0"></div>
          <div class="menu-inner-shadow"></div>

          <ul class="menu-inner py-1">
            <!-- Vouchers Header -->
            <li class="menu-header small text-uppercase">
              <span class="menu-header-text">Voucher Management</span>
            </li>

            <li class="menu-item @(currentController == "Voucher" && currentAction == "Index" ? "active" : "")">
              <a asp-controller="Voucher" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-collection"></i>
                <div data-i18n="All Vouchers">All Vouchers</div>
              </a>
            </li>

            <li class="menu-item @(currentController == "Voucher" && currentAction == "Create" ? "active" : "")">
              <a asp-controller="Voucher" asp-action="Create" class="menu-link">
                <i class="menu-icon tf-icons bx bx-plus-circle"></i>
                <div data-i18n="New Voucher">New Voucher</div>
              </a>
            </li>

            <!-- Workflow Header -->
            <li class="menu-header small text-uppercase">
              <span class="menu-header-text">Approval Workflow</span>
            </li>

            <li class="menu-item @(currentController == "Approval" && currentAction == "Pending" ? "active" : "")">
              <a asp-controller="Approval" asp-action="Pending" class="menu-link">
                <i class="menu-icon tf-icons bx bx-time-five"></i>
                <div data-i18n="Pending Approvals">My Pending Queue</div>
              </a>
            </li>

            @if (activeUser?.UserId == 1)
            {
              <li class="menu-item @(currentController == "Approval" && currentAction == "Notifications" ? "active" : "")">
                <a asp-controller="Approval" asp-action="Notifications" class="menu-link">
                  <i class="menu-icon tf-icons bx bx-bell"></i>
                  <div data-i18n="Notifications">Notifications</div>
                </a>
              </li>
            }

            <!-- Account Header -->
            <li class="menu-header small text-uppercase">
              <span class="menu-header-text">System &amp; Users</span>
            </li>

            <li class="menu-item">
              <a asp-controller="Auth" asp-action="Login" class="menu-link">
                <i class="menu-icon tf-icons bx bx-user-check"></i>
                <div data-i18n="Login">Login / Switch Actor</div>
              </a>
            </li>
          </ul>
        </aside>
        <!-- / Menu -->

        <!-- Layout container -->
        <div class="layout-page">
          <!-- Navbar -->
          <nav
            class="layout-navbar container-xxl navbar-detached navbar navbar-expand-xl align-items-center bg-navbar-theme"
            id="layout-navbar">
            <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none">
              <a class="nav-item nav-link px-0 me-xl-4" href="javascript:void(0)">
                <i class="bx bx-menu bx-sm"></i>
              </a>
            </div>

            <div class="navbar-nav-right d-flex align-items-center justify-content-between w-100" id="navbar-collapse">
              <div class="navbar-nav align-items-center">
                <div class="nav-item d-flex align-items-center">
                  <span class="badge bg-label-primary px-3 py-2 fw-semibold">
                    <i class="bx bx-shield-quarter me-1"></i>
                    SQL Server Stored Procedure Engine
                  </span>
                </div>
              </div>

              <ul class="navbar-nav flex-row align-items-center ms-auto">
                @if (activeUser != null)
                {
                  <!-- Active User Switcher dropdown -->
                  <li class="nav-item navbar-dropdown dropdown-user dropdown">
                    <a
                      class="nav-link dropdown-toggle hide-arrow d-flex align-items-center"
                      href="javascript:void(0);"
                      data-bs-toggle="dropdown">
                      <div class="avatar avatar-online me-2">
                        <span class="avatar-initial rounded-circle bg-label-primary fw-bold">
                          @activeUser.Username.Substring(0, Math.Min(2, activeUser.Username.Length)).ToUpper()
                        </span>
                      </div>
                      <div class="d-none d-md-block text-start">
                        <span class="fw-semibold d-block">@activeUser.Username</span>
                        <small class="text-muted">ID: @activeUser.UserId &bull; @(activeUser.UserRole == 1 ? "Admin" : "Approver")</small>
                      </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                      <li>
                        <div class="dropdown-item">
                          <div class="d-flex align-items-center">
                            <div class="avatar avatar-online me-3">
                              <span class="avatar-initial rounded-circle bg-label-primary fw-bold">
                                @activeUser.Username.Substring(0, Math.Min(2, activeUser.Username.Length)).ToUpper()
                              </span>
                            </div>
                            <div>
                              <h6 class="mb-0">@activeUser.Username</h6>
                              <small class="text-muted">@activeUser.Email</small>
                            </div>
                          </div>
                        </div>
                      </li>
                      <li><div class="dropdown-divider"></div></li>
                      <li class="dropdown-header text-uppercase small text-muted">Quick Switch Actor (Testing)</li>
                      @foreach (var user in allUsers.Where(u => u.Bactive == true).Take(6))
                      {
                        <li>
                          <form asp-controller="Approval" asp-action="SwitchUser" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@user.UserId" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between @(user.UserId == activeUser.UserId ? "active" : "")">
                              <span>
                                <i class="bx bx-user me-2"></i>@user.Username (ID: @user.UserId)
                              </span>
                              @if (user.UserId == activeUser.UserId)
                              {
                                <i class="bx bx-check text-primary"></i>
                              }
                            </button>
                          </form>
                        </li>
                      }
                      <li><div class="dropdown-divider"></div></li>
                      <li>
                        <a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
                          <i class="bx bx-power-off me-2"></i>
                          <span>Log Out</span>
                        </a>
                      </li>
                    </ul>
                  </li>
                }
                else
                {
                  <li class="nav-item">
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-sm">
                      <i class="bx bx-log-in me-1"></i> Sign In
                    </a>
                  </li>
                }
              </ul>
            </div>
          </nav>
          <!-- / Navbar -->

          <!-- Content wrapper -->
          <div class="content-wrapper">
            <!-- Content -->
            <div class="container-xxl flex-grow-1 container-p-y">
              <!-- Alerts / Feedback messages -->
              @if (TempData["SuccessMessage"] != null)
              {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                  <div class="d-flex align-items-center">
                    <i class="bx bx-check-circle fs-4 me-2"></i>
                    <div>@TempData["SuccessMessage"]</div>
                  </div>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              }

              @if (TempData["ErrorMessage"] != null)
              {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                  <div class="d-flex align-items-center">
                    <i class="bx bx-error-circle fs-4 me-2"></i>
                    <div>@TempData["ErrorMessage"]</div>
                  </div>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              }

              @RenderBody()
            </div>
            <!-- / Content -->

            <!-- Footer -->
            <footer class="content-footer footer bg-footer-theme">
              <div class="container-xxl d-flex flex-wrap justify-content-between py-3 flex-md-row flex-column">
                <div class="mb-2 mb-md-0">
                  &copy; @DateTime.Now.Year Approval Workflow Management System &bull; Powered by Sneat Bootstrap 5 &amp; Microsoft SQL Server
                </div>
                <div>
                  <span class="badge bg-label-info">Sneat Admin Free Template</span>
                </div>
              </div>
            </footer>
            <!-- / Footer -->

            <div class="content-backdrop fade"></div>
          </div>
          <!-- Content wrapper -->
        </div>
        <!-- / Layout page -->
      </div>

      <!-- Overlay -->
      <div class="layout-overlay layout-menu-toggle"></div>
    </div>
    <!-- / Layout wrapper -->

    <!-- Core JS -->
    <script src="~/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="~/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/assets/vendor/js/bootstrap.js"></script>
    <script src="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/assets/vendor/js/menu.js"></script>
    <script src="~/assets/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
  </body>
</html>
