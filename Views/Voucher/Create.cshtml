@model ApprovalWorkflow.Models.CreateVoucherViewModel

@{
    ViewData["Title"] = "Create Voucher";
    var currentUser = (ApprovalWorkflow.Models.User)ViewBag.CurrentUser;
}

<!-- Page Heading & Breadcrumbs -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h4 class="fw-bold py-1 mb-1">
      <span class="text-muted fw-light">Vouchers /</span> New Transaction Voucher
    </h4>
    <p class="text-muted mb-0 small">
      Enter transaction details to initiate the approval workflow.
    </p>
  </div>
  <div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
      <i class="bx bx-arrow-back me-1"></i> Back to Vouchers
    </a>
  </div>
</div>

<div class="row justify-content-center">
  <!-- Voucher Entry Form -->
  <div class="col-lg-8 col-xl-7">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header border-bottom py-3">
        <h5 class="card-title mb-0 fw-bold text-dark">
          <i class="bx bx-edit text-primary me-2"></i>Voucher Entry Form
        </h5>
      </div>
      <div class="card-body p-4">
        <form asp-action="Create" method="post" id="voucherForm">
          @Html.AntiForgeryToken()
          
          <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small" role="alert"></div>

          <!-- Voucher Number -->
          <div class="mb-3">
            <label asp-for="VoucherNo" class="form-label fw-semibold">Voucher Number <span class="text-danger">*</span></label>
            <div class="input-group input-group-merge">
              <span class="input-group-text"><i class="bx bx-hash"></i></span>
              <input asp-for="VoucherNo" class="form-control" placeholder="e.g. VOUCH-20261020-001" required />
            </div>
            <span asp-validation-for="VoucherNo" class="text-danger small"></span>
          </div>

          <!-- Date & Amount -->
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label asp-for="Date" class="form-label fw-semibold">Voucher Date <span class="text-danger">*</span></label>
              <div class="input-group input-group-merge">
                <span class="input-group-text"><i class="bx bx-calendar"></i></span>
                <input asp-for="Date" type="date" class="form-control" required />
              </div>
              <span asp-validation-for="Date" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
              <label asp-for="Amount" class="form-label fw-semibold">Amount (₹) <span class="text-danger">*</span></label>
              <div class="input-group input-group-merge">
                <span class="input-group-text fw-bold">₹</span>
                <input asp-for="Amount" id="txtAmount" type="number" step="0.01" min="0" class="form-control fw-bold text-primary fs-5" placeholder="0.00" required />
              </div>
              <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>
          </div>

          <!-- Narration -->
          <div class="mb-3">
            <label asp-for="Narration" class="form-label fw-semibold">Narration / Description</label>
            <textarea asp-for="Narration" rows="3" class="form-control" placeholder="Enter transaction purpose or expenditure description (max 100 characters)..."></textarea>
            <span asp-validation-for="Narration" class="text-danger small"></span>
          </div>

          <!-- Creator Context -->
          <div class="alert alert-light border py-2 px-3 mb-4 d-flex justify-content-between align-items-center">
            <div class="small">
              <span class="text-muted d-block">Authenticated Creator:</span>
              <strong class="text-dark"><i class="bx bx-user-check me-1 text-primary"></i>@currentUser.Username</strong>
            </div>
          </div>

          <!-- Buttons -->
          <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 shadow-sm fw-semibold">
              <i class="bx bx-save me-1"></i> Save Voucher
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>


