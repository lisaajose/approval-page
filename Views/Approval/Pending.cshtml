@model List<ApprovalWorkflow.Models.PendingApprovalItem>

@{
    ViewData["Title"] = "My Pending Approvals";
    var activeUser = (ApprovalWorkflow.Models.User)ViewBag.CurrentUser;
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-inbox text-primary me-2"></i>My Pending Approvals
        </h2>
        <p class="text-muted mb-0">
            Vouchers where <strong>@activeUser.Username</strong> (UserId: @activeUser.UserId) is the authorized approver for the <em>current</em> sequential stage.
        </p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <span class="badge bg-primary fs-6 px-3 py-2">
            @Model.Count Pending Items
        </span>
    </div>
</div>

<div class="card border-0 shadow-sm bg-white">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-secondary">
            <i class="bi bi-list-check me-2"></i>Actionable Approval Queue
        </h5>
        <span class="text-muted small">Fetched via <code>dbo.usp_GetPendingApprovals</code></span>
    </div>
    
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th scope="col" class="ps-4">Voucher No</th>
                    <th scope="col">Date</th>
                    <th scope="col">Narration</th>
                    <th scope="col" class="text-end">Amount (₹)</th>
                    <th scope="col" class="text-center">Workflow Level</th>
                    <th scope="col" class="text-center">Current Stage</th>
                    <th scope="col">Alert Message</th>
                    <th scope="col" class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-check-circle fs-1 text-success opacity-75 d-block mb-2"></i>
                            <strong>All caught up!</strong> No pending approval assignments for @activeUser.Username at this time.
                            <div class="small mt-1 text-secondary">
                                Switch user actor in the top navbar if you want to test another approver's queue.
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">
                                <a asp-controller="Voucher" asp-action="Details" asp-route-id="@item.HeaderId" class="text-decoration-none">
                                    @item.VoucherNo
                                </a>
                            </td>
                            <td>@item.Date.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@item.Narration">
                                    @(string.IsNullOrWhiteSpace(item.Narration) ? "—" : item.Narration)
                                </span>
                            </td>
                            <td class="text-end fw-bold">
                                ₹@item.Amount.ToString("N2")
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info bg-opacity-10 text-dark border border-info border-opacity-25 px-2 py-1">
                                    Level @item.WorkflowLevel
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-primary">
                                    Stage @item.StepOrder (Lvl @item.Level)
                                </span>
                            </td>
                            <td>
                                <span class="small text-secondary">@(item.Alerts ?? "Approval Required")</span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-controller="Voucher" asp-action="Details" asp-route-id="@item.HeaderId" class="btn btn-sm btn-primary shadow-sm">
                                    <i class="bi bi-pencil-square me-1"></i> Review & Decide
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
